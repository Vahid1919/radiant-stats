    "@tailwindcss/vite": "^4.3.0",
    "@types/d3": "^7.4.3",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "latest",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "latest",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
